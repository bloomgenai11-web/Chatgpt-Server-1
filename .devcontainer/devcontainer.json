{
  "name": "ChatGPT Automation Gateway + Bot GitHub",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "postCreateCommand": "chmod +x .devcontainer/setup.sh && bash .devcontainer/setup.sh",
  "postStartCommand": "pm2 start .devcontainer/ecosystem.config.js && pm2 save"
}
